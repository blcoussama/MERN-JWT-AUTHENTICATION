{
  "name": "mern-jwt-authentication",
  "version": "2.0.0",
  "private": true,
  "description": "Authentification MERN : vérification d'e-mail, JWT d'accès + refresh token en rotation (cookies httpOnly), rôles client/admin.",
  "main": "backend/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch backend/index.js",
    "dev:demo": "node backend/scripts/demo.js",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env backend/index.js",
    "build": "npm ci && npm ci --prefix frontend && npm run build --prefix frontend",
    "admin:promote": "node --env-file-if-exists=.env backend/scripts/promoteAdmin.js",
    "lint": "eslint backend",
    "test": "vitest run"
  },
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
