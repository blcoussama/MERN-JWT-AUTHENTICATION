# MERN-JWT-AUTHENTICATION : copier ce fichier en ".env" à la racine du dépôt (jamais versionné).
# Lu par `npm run dev`, `npm start` et `npm run admin:promote` (option Node --env-file-if-exists).
# Pour une démo sans MongoDB ni SendGrid : `npm run dev:demo` (aucun .env nécessaire).

# development | production
NODE_ENV=development
PORT=3000

# Connexion MongoDB (local, Docker ou Atlas)
MONGO_URI=mongodb://localhost:27017/mern-jwt-auth

# Deux secrets DIFFÉRENTS d'au moins 32 caractères, par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

# URL du front (utilisée dans les liens des e-mails)
CLIENT_URL=http://localhost:5173

# console (dev : les e-mails sont affichés dans le terminal) | sendgrid (obligatoire en production)
MAIL_TRANSPORT=console
# Requis avec MAIL_TRANSPORT=sendgrid : clé API et expéditeur vérifié dans SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=MERN JWT Auth

# Nombre de proxys de confiance devant l'app (ex. 1 sur Render/Heroku) pour que le rate-limit voie la vraie IP
TRUST_PROXY=0
